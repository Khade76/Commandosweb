# Optional Node web server / local testing only.
# Production OVH website configuration lives in the private wardogs-secrets.php file.
PORT=3000

# BisectHosting Starbase API (optional Node/local status backend)
BISECT_API_KEY=
BISECT_PANEL_HOST=https://games.bisecthosting.com
# Only the three Bisect servers; XRealm 12577 and 12648 must not be added to this list.
BISECT_SERVER_IDS=278c7bc5,9290beb1,9f71e8ef

# Optional Node/local WARDOGS RCON testing only.
# Production website RCON connections come from wardogs-secrets.php on OVH.
WARDOGS_RCON_SERVER_1_URL=http://165.217.136.52:9001
WARDOGS_RCON_SERVER_1_PASSWORD=
WARDOGS_RCON_SERVER_2_URL=http://165.217.136.99:9006
WARDOGS_RCON_SERVER_2_PASSWORD=
WARDOGS_RCON_SERVER_3_URL=
WARDOGS_RCON_SERVER_3_PASSWORD=
