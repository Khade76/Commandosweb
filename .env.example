# Production web server
PORT=3000

# BisectHosting Starbase API
# Create the key in Starbase -> Account -> API Credentials.
# Never commit the real key. Configure it directly on the server.
BISECT_API_KEY=
BISECT_PANEL_HOST=https://games.bisecthosting.com

# Comma-separated Starbase server identifiers.
BISECT_SERVER_IDS=278c7bc5,9290beb1

# Public WARDOGS display settings
WARDOGS_SERVER_REGION=Europe / UK
WARDOGS_MAX_PLAYERS=100
WARDOGS_PUBLIC_JOIN_INFO=

# WARDOGS RCON HTTP API.
# Bisect's WARDOGS RCON allocation is intentionally exposed over plain HTTP.
# These passwords are full-access bearer tokens. Keep them on the VPS only.
WARDOGS_RCON_SERVER_1_URL=http://165.217.136.52:9001
WARDOGS_RCON_SERVER_1_PASSWORD=
WARDOGS_RCON_SERVER_2_URL=http://165.217.136.99:9006
WARDOGS_RCON_SERVER_2_PASSWORD=

# Discord WARDOGS server status bots.
# Create two Discord applications/bots and place each token here on the VPS only.
# No privileged Gateway intents are required.
DISCORD_WARDOGS_SERVER_1_BOT_TOKEN=
DISCORD_WARDOGS_SERVER_1_IDENTIFIER=278c7bc5
DISCORD_WARDOGS_SERVER_2_BOT_TOKEN=
DISCORD_WARDOGS_SERVER_2_IDENTIFIER=9290beb1

# Set this to the 44th Discord guild ID while testing so /status registers immediately.
# Leave blank to register /status globally instead.
DISCORD_GUILD_ID=

# Point the VPS bots at the public OVH PHP server endpoint.
# Example: https://your-domain.example/api/servers.php
# Defaults to http://127.0.0.1:$PORT/api/servers when blank.
DISCORD_STATUS_API_URL=
DISCORD_STATUS_REFRESH_MS=30000

# Persistent WARDOGS player stats service on the VPS.
WARDOGS_STATS_HOST=0.0.0.0
WARDOGS_STATS_PORT=3100
WARDOGS_STATS_POLL_MS=60000
WARDOGS_STATS_FILE=./runtime/wardogs-player-stats.json
# Public stats are safe to read from the website. Restrict this to your website origin if preferred.
WARDOGS_STATS_ALLOWED_ORIGIN=*

# Optional per-server overrides. If omitted, live provider names are used.
WARDOGS_SERVER_1_NAME=
WARDOGS_SERVER_1_REGION=
WARDOGS_SERVER_1_MAX_PLAYERS=
WARDOGS_SERVER_1_JOIN_ID=175590
WARDOGS_SERVER_1_JOIN_INFO=

WARDOGS_SERVER_2_NAME=
WARDOGS_SERVER_2_REGION=
WARDOGS_SERVER_2_MAX_PLAYERS=
WARDOGS_SERVER_2_JOIN_ID=294832
WARDOGS_SERVER_2_JOIN_INFO=
