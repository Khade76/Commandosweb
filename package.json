{
  "name": "44th-commando-wardogs-web",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test:bisect": "node scripts/test-bisect.mjs",
    "test:rcon": "node scripts/test-rcon.mjs",
    "probe:join-code": "node scripts/probe-join-code.mjs && node scripts/probe-bisect-console.mjs",
