    "probe:join-public": "node scripts/probe-public-server-browser.mjs",
    "probe:join-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-client-join-code.ps1",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
