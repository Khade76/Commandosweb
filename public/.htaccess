# Apache static hosting: serve the React entry point for website page routes.
# Upload this hidden file alongside index.html and assets/ from dist/.
RewriteEngine On

# Leave real assets, directories and server endpoints alone.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^(?:about|companies(?:/[^/]+)?|servers|enlist|rules|wardogs|donate)/?$ index.html [L]
