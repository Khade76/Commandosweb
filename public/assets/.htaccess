# Browser caching for public website assets only.
# Upload this file as /www/assets/.htaccess. Keep /www/.htaccess unchanged.
# If assets/.htaccess already exists, merge this block instead of replacing it.
<IfModule mod_headers.c>
  # Unversioned assets can change at the same URL; revalidate after one hour.
  <FilesMatch "\.(?:css|m?js|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|mp3|ogg|wav)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Vite output contains an eight-character content hash in each bundle name.
  # Changed builds use different URLs, so these bundles may be cached for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(?:m?js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
